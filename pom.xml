<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Build aggregator only. Deliberately NOT a <parent> of any module:
        io.github.rifatcakir:spring-ai-test-tools is published on Maven Central, and a
        parent pom would have to be published alongside it for consumers to resolve the
        library. Each module stays self-contained; this file only lists them so one
        `mvn test` at the root builds and tests everything. Never deployed.
    -->
    <groupId>io.github.rifatcakir</groupId>
    <artifactId>spring-ai-test-tools-build</artifactId>
    <version>0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-ai-test-tools (build aggregator)</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <modules>
        <module>spring-ai-test-tools</module>
        <module>spring-ai-test-tools-server</module>
        <!-- After the server: its integration tests need the server jar. -->
        <module>spring-ai-test-tools-it</module>
    </modules>
</project>
