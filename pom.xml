<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.rifatcakir</groupId>
    <artifactId>spring-ai-test-tools-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>spring-ai-test-tools (reactor)</name>
    <description>Multi-module aggregator for spring-ai-test-tools and its build tooling
        (docs/V2-TOOLING-PRD.md). This POM itself is not the published library artifact --
        that remains io.github.rifatcakir:spring-ai-test-tools, built by the
        spring-ai-test-tools module below with its own coordinates unchanged.</description>
    <url>https://github.com/rifatcakir/spring-ai-test-tools</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>rifatcakir</id>
            <name>Rifat Cakir</name>
            <email>rifatcakira@gmail.com</email>
            <url>https://github.com/rifatcakir</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/rifatcakir/spring-ai-test-tools.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/rifatcakir/spring-ai-test-tools.git</developerConnection>
        <url>https://github.com/rifatcakir/spring-ai-test-tools</url>
    </scm>

    <modules>
        <module>spring-ai-test-tools</module>
        <module>spring-ai-test-tools-build-core</module>
        <module>spring-ai-test-tools-maven-plugin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring AI 2.0 requires Spring Boot 4.0+ / Spring Framework 7.0 and Jackson 3. -->
        <spring-boot.version>4.0.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- spring-boot-dependencies:4.0.0 manages testcontainers.version=2.0.2 via an
             imported testcontainers-bom, but that version does not exist as a published,
             downloadable artifact (verified: Maven Central's newest real org.testcontainers
             release is 1.21.3 as of this writing). Pinned explicitly in the
             spring-ai-test-tools module's testcontainers dependencies for this reason;
             kept as a shared property here so both modules and CI reference one place.
             Remove the explicit <version> on each testcontainers dependency once the
             BOM-managed version is real. -->
        <testcontainers.version>1.21.3</testcontainers.version>

        <!-- Real Maven Central releases, confirmed against maven-metadata.xml rather than
             guessed (this project's own CLAUDE.md/PUBLISHING.md discipline): 3.9.16 is the
             newest stable (non-alpha/beta/rc) Maven 3 line release as of this writing; Maven
             4 is still pre-release (rc-5). A plugin built against the stable 3.9.x API
             remains usable by the overwhelming majority of consumers still on Maven 3. -->
        <maven-plugin-api.version>3.9.16</maven-plugin-api.version>
        <maven-plugin-tools.version>3.15.2</maven-plugin-tools.version>

        <!-- Overridden to empty by the integration-test profile below. Kept as a property
             rather than an inline <excludedGroups> override in the profile because Maven
             materializes an implicit default-test execution from the plugin's top-level
             configuration, and a profile's plugin-level <configuration> override does not
             reach into that synthesized execution — a property substitution does. -->
        <surefire.excludedGroups>integration</surefire.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Imported rather than inherited: spring-ai-test-tools is a library, not an
                 application, and the tooling modules have no need for either BOM at all
                 beyond what they declare directly. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Real end-to-end tests (spring-ai-test-tools module only, today)
                         need Docker + a real Ollama model and are comparatively slow;
                         excluded from the default build so `mvn test` from the reactor
                         root never requires a container runtime. Run with
                         -Pintegration-test. Harmless no-op for modules with no
                         @Tag("integration") tests. -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integration-test</id>
            <properties>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
